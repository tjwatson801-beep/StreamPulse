{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2021", "DOM", "DOM.Iterable"], "strict": true,
    "module": "ESNext", "moduleResolution": "Bundler", "resolveJsonModule": true,
    "isolatedModules": true, "noEmit": true, "jsx": "react-jsx", "skipLibCheck": true,
    "esModuleInterop": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
